# ==========================================================================
# Exam-Portal backend — required/optional environment variables.
# Copy to a real environment (shell export, systemd, container env, etc.).
# Spring Boot reads these as OS env vars; values here are safe placeholders.
# Never commit a filled-in .env with real secrets.
# ==========================================================================

# --- Database (MySQL) -----------------------------------------------------
# Defaults target a local MySQL on :3306 with database "exam-portal".
DB_URL=jdbc:mysql://localhost:3306/exam-portal?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=change-me

# --- JWT signing secret (REQUIRED in production) --------------------------
# App falls back to a public dev secret if unset — never rely on that in prod.
# Use a long, random, high-entropy value.
JWT_SECRET=replace-with-a-long-random-secret

# --- First SUPER_ADMIN seed ----------------------------------------------
# The super admin is seeded on startup ONLY if SUPERADMIN_PASSWORD is set.
# Leave the password blank to skip seeding.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
SUPERADMIN_PHONE=0000000000

# --- The Mentalist PDF report storage ------------------------------------
# Directory where generated PDF reports are written.
MENTALIST_REPORTS_DIR=./data/mentalist-reports
