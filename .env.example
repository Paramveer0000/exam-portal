# ==========================================================================
# Docker Compose / production deployment environment.
# Copy to .env (which is git-ignored) and fill in real values.
#   cp .env.example .env
# Every variable consumed by docker-compose.yml is listed here.
# ==========================================================================

################################
# Database (MySQL 8)
################################
# Database/schema name (auto-created on first boot).
DB_NAME=exam-portal
# MySQL root password — REQUIRED. Compose refuses to start if unset.
DB_PASSWORD=change-me-strong-db-password

################################
# Authentication (JWT)
################################
# REQUIRED. Long, random, high-entropy secret used to sign JWTs.
# The prod profile refuses to start if this is unset, too short (<32), or the
# built-in dev default. Generate one, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-64-char-secret

################################
# First Super Admin (seeded on first boot only)
################################
# Leave SUPERADMIN_PASSWORD blank to skip seeding (create the admin manually later).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
SUPERADMIN_PHONE=0000000000

################################
# Web / networking
################################
# Host port the frontend (nginx) is published on. Front this with a TLS proxy
# (or let Dockploy's built-in proxy publish/terminate it for you).
FRONTEND_PORT=8080
# IANA timezone applied to all containers (logs/timestamps). Example: Asia/Kolkata
TZ=UTC
# REQUIRED for real deployments. Comma-separated origin(s) the browser sends in
# the Origin header — must exactly match your public site URL(s) (scheme + host,
# no trailing slash) or the backend rejects every login/API call as "Invalid
# CORS request". Defaults to http://localhost:3000 (dev only) if unset.
CORS_ALLOWED_ORIGINS=https://your-domain.example

################################
# AI provider (NOT set here)
################################
# The AI provider API key is configured at runtime by a SUPER_ADMIN in the app
# (Super Admin -> AI Settings) and stored in the database (masked in responses),
# NOT via an environment variable. No OPENAI_API_KEY / provider key belongs here.

################################
# Email / Object storage (NOT used)
################################
# This application does not send email and does not use S3/object storage, so no
# SMTP_* or S3_* variables are required.
